{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES6",
    "paths": {
      "@/*": ["./*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app",
    "components",
    "stores/usePressableElementsStore.ts",
    "translations",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
